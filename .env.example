HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5175
TRUST_PROXY=loopback
LOCAL_TEST_MODE=true
DATABASE_PATH=runtime/local-test/anonyma.sqlite
MEDIA_PATH=runtime/local-test/media
CATALOG_PATH=runtime/local-test/models.cache.json
RELEASED_FEATURES=mvp
AUTO_SYNC_MODELS=false
# Local test configuration only. Never deploy test mode publicly.
APP_SECRET=
GATEWAY_API_KEY=

# Support delivery uses SMTP. Set an inbox you monitor.
SMTP_URL=
SMTP_FROM=
SUPPORT_EMAIL=

# Production requires NODE_ENV=production, LOCAL_TEST_MODE=false and matching
# HTTPS APP_ORIGIN/PUBLIC_BASE_URL. Keep live storage separate from test data.
# Shared Redis REST quotas are required when SERVER_INSTANCES is greater than 1.
SERVER_INSTANCES=1
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
RATE_LIMIT_NAMESPACE=anonyma
BUILD_COMMIT_SHA=
