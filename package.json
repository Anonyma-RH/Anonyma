{
  "name": "anonyma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch --env-file-if-exists=.env server/index.js\" \"vite\"",
    "build": "vite build && node scripts/build-version.mjs",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run identity:check && npm run check:static && npm run check:dependencies && npm run check:secrets && npm run build && npm test",
    "identity:setup": "node scripts/setup-identity.mjs",
    "identity:check": "node scripts/check-identity.mjs",
    "prepare": "node scripts/setup-identity.mjs",
    "check:static": "node scripts/static-check.mjs",
    "check:dependencies": "npm audit --audit-level=moderate",
    "check:secrets": "node scripts/check-secrets.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@fontsource/gfs-didot": "5.3.0",
    "@fontsource/gfs-neohellenic": "5.3.0",
    "@lottiefiles/dotlottie-web": "0.68.0",
    "@mozilla/readability": "0.6.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@walletconnect/ethereum-provider": "2.25.0",
    "animejs": "4.3.6",
    "cookie-parser": "1.4.7",
    "ehbp": "0.3.2",
    "ethers": "6.17.0",
    "express": "5.2.1",
    "jszip": "3.10.2",
    "linkedom": "0.18.13",
    "lucide-react": "1.47.0",
    "nodemailer": "10.0.10",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "three": "0.184.0",
    "tinfoil": "1.2.1"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "10.0.5",
    "dompurify": "3.4.16",
    "katex": "0.16.47",
    "mermaid": "11.17.2",
    "opentype.js": "2.0.0",
    "prettier": "3.9.8",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "supertest": "7.2.2",
    "unified": "11.0.5",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@freedomofpress/crypto-browser": {
      "@noble/curves": "1.9.7"
    }
  }
}
